# Core
APP_TITLE=Disciple Tools
NODE_ENV=development
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL — match ../docker/postgresql/.env when using local Docker
DATABASE_URL=postgresql://dtv2:dtv2_dev_change_me@localhost:5432/dtv2

# Auth (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Mailgun — in development, blueprint may route to MailHog (see blueprint email README)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_HOST=
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Disciple Tools

# Optional: S3-compatible storage (see blueprint s3-storage)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
